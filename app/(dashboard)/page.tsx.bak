// Quick stats with more realistic data
const stats = [
  { label: "Total Balance", value: "$12,450.00", change: "+2.5%", icon: Wallet, color: "teal" },
  { label: "This Month", value: "$3,240.00", change: "+12%", icon: TrendingUp, color: "green" },
  { label: "UPI ID", value: "john@fluxpay", change: "Active", icon: Smartphone, color: "blue" },
];

// Quick actions with UPI features
const quickActions = [
  { icon: Send, label: "Send Money", href: "/send", color: "teal" },
  { icon: QrCode, label: "Scan QR", href: "/scan", color: "purple" },
  { icon: Plus, label: "Add Funds", href: "/add-funds", color: "green" },
  { icon: CreditCard, label: "Cards", href: "/cards", color: "blue" },
];

export default function DashboardPage() {
  const [isLoading, setIsLoading] = useState(false);
  const [balanceVisible, setBalanceVisible] = useState(true);
  const [currentTime, setCurrentTime] = useState(new Date());

  // Update time
  useEffect(() => {
    const timer = setInterval(() => setCurrentTime(new Date()), 60000);
    return () => clearInterval(timer);
  }, []);

  // Simulate loading
  const handleRefresh = () => {
    setIsLoading(true);
    setTimeout(() => setIsLoading(false), 1000);
  };

  const formatTime = (date: Date) => {
    return date.toLocaleTimeString('en-US', {
      hour: '2-digit',
      minute: '2-digit',
      hour12: true
    });
  };

  const formattedDate = currentTime.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });
  const formattedTime = formatTime(currentTime);

  return (
    <div className="space-y-6 animate-fade-in">
      {/* Welcome Section with time */}
      <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 animate-slide-up">
        <div>
          <h1 className="text-2xl sm:text-3xl font-bold text-white">
            Hey John! 👋
          </h1>
          <p className="text-slate-400 mt-1" suppressHydrationWarning>
            {formattedDate} • {formattedTime} • Looking good today!
          </p>
        </div>
        <div className="flex items-center gap-2">
          <Button
            variant="outline"
            onClick={handleRefresh}
            disabled={isLoading}
            className="border-slate-700/50 text-slate-300 hover:bg-slate-800/50 hover:text-white"
          >
            {isLoading ? (
              <Clock className="w-4 h-4 mr-2 animate-spin" />
            ) : (
              <Clock className="w-4 h-4 mr-2" />
            )}
            Refresh
          </Button>
          <Button
            variant="outline"
            size="icon"
            className="relative border-slate-700/50 text-slate-300 hover:bg-slate-800/50 hover:text-white"
          >
            <Bell className="w-5 h-5" />
            <span className="absolute top-1.5 right-1.5 w-2 h-2 bg-teal-500 rounded-full" />
          </Button>
        </div>
      </div>

      {/* Enhanced Balance Card with UPI ID */}
      <Card className="bg-gradient-to-br from-teal-500/10 to-blue-500/10 border-teal-500/20 overflow-hidden relative animate-scale-in delay-100 hover-card-premium">
        <div className="absolute top-0 right-0 w-64 h-64 bg-teal-500/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2" />
        <CardContent className="p-6 sm:p-7 relative">
          <div className="flex items-center justify-between mb-5">
            <div className="space-y-3">
              <div className="flex items-center gap-2">
                <p className="text-slate-400 text-sm font-medium">Available Balance</p>
                <Sparkles className="w-4 h-4 text-teal-400" />
              </div>
              <div className="flex items-baseline gap-3">
                {balanceVisible ? (
                  <h2 className="text-4xl sm:text-5xl font-bold text-white balance-glow">
                    $12,450.00
                  </h2>
                ) : (
                  <h2 className="text-4xl sm:text-5xl font-bold text-slate-600">••••••</h2>
                )}
                <Button
                  variant="ghost"
                  size="sm"
                  onClick={() => setBalanceVisible(!balanceVisible)}
                  className="text-slate-500 hover:text-slate-300"
                >
                  {balanceVisible ? "Hide" : "Show"}
                </Button>
              </div>
              <div className="flex items-center gap-4">
                <p className="text-teal-400 text-sm font-medium flex items-center gap-1">
                  <TrendingUp className="w-4 h-4" />
                  +$450.00 this week
                </p>
                <div className="flex items-center gap-2 px-2 py-1 bg-slate-700/50 rounded-full">
                  <Smartphone className="w-3 h-3 text-slate-400" />
                  <span className="text-xs text-slate-300 font-mono">john@fluxpay</span>
                </div>
              </div>
            </div>

            <div className="flex items-center gap-2">
              <div className="w-12 h-12 rounded-xl bg-gradient-to-br from-teal-400 to-teal-600 flex items-center justify-center">
                <QrCode className="w-6 h-6 text-white" />
              </div>
              <div>
                <p className="text-xs text-slate-500">UPI ID</p>
                <p className="text-sm font-mono text-white">john@fluxpay</p>
              </div>
            </div>
          </div>

          {/* Enhanced Quick Actions */}
          <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-8">
