                className="flex items-center gap-4 p-4 hover:bg-slate-800/50 transition-colors"
                style={{ animationDelay: `${index * 50}ms` }}
              >
                {/* Avatar with payment method indicator */}
                <div className="relative">
                  <div className="w-10 h-10 rounded-full bg-gradient-to-br from-slate-600 to-slate-700 flex items-center justify-center flex-shrink-0">
                    <span className="text-xs font-medium text-slate-300">{transaction.avatar}</span>
                  </div>
                  <div className="absolute -bottom-1 -right-1 w-4 h-4 rounded-full bg-slate-800 border border-slate-600 flex items-center justify-center">
                    {transaction.paymentMethod === 'upi' ? (
                      <Smartphone className="w-2 h-2 text-teal-400" />
                    ) : (
                      <CreditCard className="w-2 h-2 text-blue-400" />
                    )}
                  </div>
                </div>

                {/* Info */}
                <div className="flex-1 min-w-0">
                  <div className="flex items-center gap-2">
                    <p className="text-sm font-medium text-white truncate">{transaction.name}</p>
                    <Badge variant="outline" className="text-xs px-1.5 py-0.5 border-slate-600 text-slate-400 bg-slate-800/50">
                      {transaction.category}
                    </Badge>
                  </div>
                  <p className="text-xs text-slate-500">{transaction.date}</p>
                </div>

                {/* Amount */}
                <div className="text-right">
                  <p
                    className={`text-sm font-semibold ${transaction.type === "received" ? "text-teal-400" : "text-white"
                      }`}
                  >
                    {transaction.type === "received" ? "+" : ""}
                    ${Math.abs(transaction.amount).toFixed(2)}
                  </p>
                  <div className="flex items-center gap-1">
                    {transaction.type === "received" ? (
                      <ArrowDownLeft className="w-3 h-3 text-teal-400" />
                    ) : (
                      <ArrowUpRight className="w-3 h-3 text-white" />
                    )}
                    <span className="text-xs text-slate-500">{transaction.type}</span>
                  </div>
                </div>

                {/* More actions */}
                <Button
                  variant="ghost"
                  size="icon"
                  className="h-8 w-8 text-slate-500 hover:text-slate-300"
                >
                  <MoreHorizontal className="w-4 h-4" />
                </Button>
              </div>
            ))}
          </div>
        </CardContent>
      </Card>

      {/* Quick Transfer Section */}
      <Card className="bg-gradient-to-br from-purple-500/10 to-blue-500/10 border-purple-500/20 animate-slide-up delay-500">
        <CardContent className="p-6">
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-3">
              <div className="w-12 h-12 rounded-xl bg-gradient-to-br from-purple-500 to-blue-500 flex items-center justify-center">
                <Zap className="w-6 h-6 text-white" />
              </div>
              <div>
                <h3 className="text-lg font-semibold text-white">Quick Transfer</h3>
                <p className="text-slate-400 text-sm">Send money instantly with UPI</p>
              </div>
            </div>
            <Button
              asChild
              className="bg-gradient-to-r from-purple-500 to-blue-500 hover:from-purple-600 hover:to-blue-600 text-white font-semibold"
            >
              <Link href="/send">
                <Scan className="w-5 h-5 mr-2" />
                Scan & Pay
              </Link>
            </Button>
          </div>
        </CardContent>
      </Card>

      {/* UPI Lite Widget */}
      {/* UPI Lite Widget */}
      {/* <div className="animate-slide-up delay-600">
        <UPILiteWidget
          balance={250.00}
          onTopUp={() => console.log('Top up UPI Lite')}
          onQuickPay={() => console.log('Quick pay with UPI Lite')}
        />
      </div> */}

      {/* Market News Widget */}
      {/* <div className="animate-slide-up delay-700">
        <MarketNewsWidget />
      </div> */}
    </div>
  );
}
