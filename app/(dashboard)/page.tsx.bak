                  ? 'bg-gradient-to-r from-teal-500 to-teal-600 hover:from-teal-600 hover:to-teal-700 text-white shadow-teal-500/20'
                  : action.color === 'purple'
                    ? 'bg-gradient-to-r from-purple-500 to-purple-600 hover:from-purple-600 hover:to-purple-700 text-white shadow-purple-500/20'
                    : action.color === 'green'
                      ? 'bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white shadow-green-500/20'
                      : 'bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white shadow-blue-500/20'
                  }`}
              >
                <Link href={action.href} className="flex items-center gap-2">
                  <action.icon className="w-5 h-5" />
                  <span className="hidden sm:inline">{action.label}</span>
                </Link>
              </Button>
            ))}
          </div>
        </CardContent>
      </Card>

      {/* Enhanced Stats Grid */}
      <div className="grid grid-cols-1 sm:grid-cols-3 gap-4 animate-slide-up delay-200">
        {stats.map((stat, index) => (
          <Card
            key={stat.label}
            className="bg-slate-800/30 border-slate-700/50 hover-lift"
            style={{ animationDelay: `${index * 100}ms` }}
          >
            <CardContent className="p-5">
              <div className="flex items-start justify-between">
                <div>
                  <p className="text-slate-400 text-sm">{stat.label}</p>
                  <h3 className="text-2xl font-bold text-white mt-1">{stat.value}</h3>
                  <p className={`text-xs font-medium mt-1 ${stat.label === "UPI ID" ? "text-blue-400" : "text-teal-400"
                    }`}>
                    {stat.change}
                  </p>
                </div>
                <div className={`w-10 h-10 rounded-lg flex items-center justify-center ${stat.color === 'teal' ? 'bg-teal-500/10' :
                  stat.color === 'green' ? 'bg-green-500/10' :
                    'bg-blue-500/10'
                  }`}>
                  <stat.icon className={`w-5 h-5 ${stat.color === 'teal' ? 'text-teal-400' :
                    stat.color === 'green' ? 'text-green-400' :
                      'text-blue-400'
                    }`} />
                </div>
              </div>
            </CardContent>
          </Card>
        ))}
      </div>

      {/* Recent Transactions with more details */}
      <Card className="bg-slate-800/30 border-slate-700/50 animate-slide-up delay-400">
        <CardHeader className="flex flex-row items-center justify-between pb-4">
